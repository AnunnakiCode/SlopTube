
// Generated from android/java/YouTubeLoginActivity.java.in
package @SLOPTUBE_APP_ID@;

import android.app.Activity;
import android.os.Bundle;
import android.webkit.CookieManager;
import android.webkit.WebChromeClient;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import android.widget.FrameLayout;
import android.widget.TextView;
import android.view.Gravity;
import android.view.ViewGroup;

import java.util.HashMap;
import java.util.Map;

public final class YouTubeLoginActivity extends Activity {

    private WebView webView;
    private TextView status;
    private boolean sessionSaved = false;

    @Override
    protected void onCreate(Bundle state) {
        super.onCreate(state);

        FrameLayout root = new FrameLayout(this);

        webView = new WebView(this);
        status = new TextView(this);
        status.setText("Inicia sesión en tu cuenta de Google");
        status.setGravity(Gravity.CENTER);
        status.setPadding(16, 12, 16, 12);

        FrameLayout.LayoutParams statusParams = new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT,
                Gravity.TOP
        );

        FrameLayout.LayoutParams webParams = new FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.MATCH_PARENT
        );
        webParams.topMargin = 56;

        root.addView(webView, webParams);
        root.addView(status, statusParams);
        setContentView(root);

        CookieManager cookies = CookieManager.getInstance();
        cookies.setAcceptCookie(true);
        cookies.setAcceptThirdPartyCookies(webView, true);

        webView.getSettings().setJavaScriptEnabled(true);
        webView.getSettings().setDomStorageEnabled(true);
        webView.setWebChromeClient(new WebChromeClient());

        webView.setWebViewClient(new WebViewClient() {
            @Override
            public void onPageFinished(WebView view, String url) {
                super.onPageFinished(view, url);
                checkYouTubeSession();
            }
        });

        webView.loadUrl("https://www.youtube.com/");
    }

    private void checkYouTubeSession() {
        if (sessionSaved || isFinishing()) {
        return;
    }
    CookieManager manager = CookieManager.getInstance();

    String youtubeCookies =
            manager.getCookie("https://www.youtube.com");

    if (youtubeCookies == null || youtubeCookies.isEmpty()) {
        status.setText("Inicia sesión en tu cuenta de YouTube");
        return;
    }

    Map<String, String> values = new HashMap<>();
    readCookies(values, youtubeCookies);

    boolean hasSid = values.containsKey("SID");
    boolean hasSap = values.containsKey("SAPISID")
            || values.containsKey("__Secure-3PAPISID");

    if (!hasSid || !hasSap) {
        status.setText("Inicia sesión para conectar tu cuenta");
        return;
    }

    try {
        manager.flush();
        YouTubeSessionStore.save(this, youtubeCookies);

        status.setText("Cuenta de YouTube conectada");
        setResult(RESULT_OK);
        finish();

    } catch (java.security.GeneralSecurityException error) {
        status.setText("No se pudo proteger la sesión");
        setResult(RESULT_CANCELED);
    }
}

    private static void readCookies(
            Map<String, String> destination,
            String cookieString
    ) {
        if (cookieString == null || cookieString.isEmpty()) {
            return;
        }

        for (String item : cookieString.split(";")) {
            String[] pair = item.trim().split("=", 2);
            if (pair.length == 2) {
                destination.put(pair[0], pair[1]);
            }
        }
    }

    @Override
    public void onBackPressed() {
        if (webView != null && webView.canGoBack()) {
            webView.goBack();
        } else {
            setResult(RESULT_CANCELED);
            super.onBackPressed();
        }
    }

    @Override
    protected void onDestroy() {
        if (webView != null) {
            webView.stopLoading();
            webView.destroy();
            webView = null;
        }
        super.onDestroy();
    }
}
